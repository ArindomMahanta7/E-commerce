# ShopNest frontend environment variables
# Copy this file to `.env` and adjust the values for your environment.
# All VITE_* variables are exposed to the browser bundle - NEVER put secrets here.

# Base URL of the running Express backend.
# The backend reads PORT from backend/.env and falls back to 3000 (see backend/index.js).
# Do NOT include a trailing slash and do NOT append "/api" - service paths add it.
VITE_API_BASE_URL=http://localhost:3000

# Razorpay PUBLIC key id (key_id) used by the browser checkout widget.
# The Razorpay secret must stay on the server (backend/.env) and is never used here.
# The backend also needs RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET in backend/.env.
VITE_RAZORPAY_KEY_ID=
